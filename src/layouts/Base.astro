---
import '../styles/site.css';
import Nav from '../components/Nav.astro';

const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL;

// GA4 측정 ID. Google Analytics에서 발급받은 G-로 시작하는 값으로 교체하면 수집이 시작됩니다.
// 아래 자리표시자 그대로면 스크립트를 아예 로드하지 않습니다(로컬 개발 시 오염 방지).
const GA_ID = 'G-21ZNJNXE5G';
const gaEnabled = GA_ID.startsWith('G-') && !GA_ID.includes('XXXXXXXXXX');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="stylesheet" href={`${base}_ds/nocturne/styles.css`} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    {gaEnabled && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}
  </head>
  <body>
    <Nav current={current} />
    <slot />
    <script>
      const track = (name: string, params: Record<string, unknown> = {}) => {
        (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.('event', name, params);
      };

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        // 1) 교안(덱) 열람 — 가장 강한 관심 신호
        const deck = target.closest<HTMLAnchorElement>('a[href*="deck-"]');
        if (deck) track('deck_open', { deck_url: deck.getAttribute('href') });

        // 2) 외부 링크 — GitHub · 구름 · 해커톤 · 데모
        const out = target.closest<HTMLAnchorElement>('a[href^="http"]');
        if (out && out.hostname !== window.location.hostname) {
          track('outbound_click', { link_domain: out.hostname, link_url: out.href });
        }

        // 3) Contact(mailto) — 이메일 복사 + 전환 이벤트
        const link = target.closest('a[href^="mailto:"]');
        if (!(link instanceof HTMLAnchorElement)) return;
        e.preventDefault();

        track('contact_click', { location: link.closest('.nav') ? 'nav' : 'page' });

        const email = link.href.replace(/^mailto:/, '').split('?')[0];

        const showTip = (text: string) => {
          const tip = document.createElement('span');
          tip.className = 'copy-tip';
          tip.setAttribute('role', 'status');
          tip.textContent = text;
          link.appendChild(tip);
          requestAnimationFrame(() => tip.classList.add('show'));
          setTimeout(() => {
            tip.classList.remove('show');
            setTimeout(() => tip.remove(), 200);
          }, 1400);
        };

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(email).then(
            () => showTip('이메일이 복사되었습니다'),
            () => { window.location.href = link.href; }
          );
        } else {
          window.location.href = link.href;
        }
      });

      // 4) 스크롤 깊이 — 끝까지 읽었는지 (GA4 기본 수집은 90%만 잡음)
      const marks = [50, 75];
      const fired = new Set<number>();
      let ticking = false;
      const checkScroll = () => {
        ticking = false;
        const doc = document.documentElement;
        const scrollable = doc.scrollHeight - window.innerHeight;
        if (scrollable <= 0) return;
        const pct = (window.scrollY / scrollable) * 100;
        for (const m of marks) {
          if (pct >= m && !fired.has(m)) {
            fired.add(m);
            track('scroll_depth', { percent: m });
          }
        }
      };
      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(checkScroll);
      }, { passive: true });
    </script>
  </body>
</html>
